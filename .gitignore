# Datasets
# Ignore all raw/processed video datasets
datasets/*
!datasets/.gitkeep

# Models
# Ignore downloaded heavy weights like yolov8n.pt
models/*
!models/.gitkeep

# Outputs
# Ignore all generated logs, json, csv, and annotated videos
outputs/*
!outputs/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
